# Runtime state. `eccx index`, `vectors` and `feedback` write here; none of it
# is source. `observations.jsonl` also contains the queries actually run.
.eccx/
.eccx

# Mutation testing artefacts (8 MB, regenerated by tools/mutate.sh in ~21 min)
mutants/
.mutmut-cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local indexes for a user corpus live in ~/.eccx/<slug>/, never in the repo,
# but a user may point --corpus at a directory inside a checkout.
/corpus/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Coverage artefacts (regenerated by run-checks.sh)
.coverage
coverage.xml
htmlcov/

# Runtime memory written by the tool itself (e.g. a test that ran an MCP roundtrip)
.ecc/

# Packaging artefacts (python -m build); a wheel in the tree is never source
build/
dist/

# Dépendances Node de la base vendue (jamais versionnées) : ./tools/vendor_bootstrap.sh
vendor/ecc/node_modules/
